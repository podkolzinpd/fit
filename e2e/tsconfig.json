{
  "compilerOptions": {
    "tsBuildInfoFile": "../node_modules/.tmp/tsconfig.e2e.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "#fit/local-auth": ["../src/app/local-auth-composition.ts"],
      "#fit/local-data": ["../src/app/local-data-composition.ts"],
      "#fit/local-assistant": ["../src/app/local-assistant-composition.ts"]
    },
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "@playwright/test", "vite/client"]
  },
  "include": ["./*.ts", "./*.tsx"]
}
