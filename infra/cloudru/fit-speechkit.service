[Unit]
Description=Fit authenticated Cloud.ru SpeechKit relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/libexec/fit-cloudru-speechkit
ExecStop=/usr/bin/podman rm --force --time 5 --ignore fit-speechkit-cloudru
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
UMask=0077
LogRateLimitIntervalSec=1min
LogRateLimitBurst=120

[Install]
WantedBy=multi-user.target
