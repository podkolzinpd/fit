[Unit]
Description=Fit resource and service monitoring
After=network-online.target

[Service]
Type=oneshot
User=nobody
Group=nogroup
ExecStart=/usr/bin/python3 /opt/fit-monitor/monitor.py --mode host --state /var/lib/fit-monitor/state.json
StateDirectory=fit-monitor
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=64M
CPUQuota=5%
TimeoutStartSec=45
