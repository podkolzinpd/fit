# Local Supabase only. Production values belong in Vercel, never in local env files.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
VITE_TRAINER_DISCOVERY_HOME_ENABLED=true

# Global cutover maintenance screen. Keep false until the product owner gives
# an explicit command to start the maintenance window.
VITE_MAINTENANCE_MODE=false

# Public, default-off read-only Yandex ID pilot settings. Never add the OAuth
# client secret here. Supply reviewed values only in the environment used for
# the pilot.
VITE_YANDEX_ID_PILOT_ENABLED=false
VITE_YANDEX_OAUTH_CLIENT_ID=
VITE_YANDEX_API_BASE_URL=
VITE_YANDEX_SESSION_LINKING_ENABLED=false
VITE_YANDEX_ACCOUNT_LINK_REQUIRED=false
VITE_YANDEX_APP_SESSION_ENABLED=false
VITE_YANDEX_MAIN_ROUTING_ENABLED=false
VITE_YANDEX_NATIVE_REGISTRATION_ENABLED=false
# Final authentication cutover. Effective only when the three switches above
# are also true. Keep false until the product owner starts the cutover.
VITE_YANDEX_ONLY_AUTH_ENABLED=false

# Optional browser-to-stage bridge for legacy Supabase-authenticated features.
# When set in the deployed frontend, chat photos are authorized with the
# Supabase session but stored by the stage API in private Yandex Object Storage.
# This is a public API origin, not a credential.
VITE_YANDEX_LEGACY_FUNCTIONS_API_BASE_URL=

# Edge Function secrets. Keep real values in Supabase Secrets, never in VITE_* variables.
YANDEX_CLOUD_API_KEY=
YANDEX_CLOUD_FOLDER_ID=
YANDEX_CLOUD_MODEL_ID=yandexgpt
VITE_SPEECHKIT_RELAY_URL=wss://89-169-132-80.sslip.io/stt

# VAPID public key for Web Push (safe to expose — it is the public half of
# the keypair, used only to open a push subscription). The matching private
# key never goes here — it lives only in the fit-send-push-notifications
# Cloud Function's Lockbox secret. Generate with `npx web-push generate-vapid-keys`.
VITE_VAPID_PUBLIC_KEY=
