{
  "name": "fit-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/run-local-stack.mjs --dev",
    "local:prepare": "node scripts/run-local-stack.mjs",
    "local:verify": "node scripts/run-local-stack.mjs --verify",
    "dev:frontend": "vite --port 5173",
    "build": "tsc -b && vite build",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset --local",
    "db:test": "supabase test db --local",
    "db:types": "supabase gen types typescript --local > src/data/database.types.ts",
    "db:types:check": "node scripts/check-db-types.mjs",
    "migrations:check": "node scripts/check-migrations.mjs",
    "infra:policy:test": "node --test scripts/check-yandex-terraform-plan.test.mjs scripts/deploy-yandex-serverless-revision.test.mjs",
    "ios:permissions:check": "node scripts/check-ios-permissions.mjs",
    "api:check": "npm --prefix services/api run check",
    "ai:smoke": "node scripts/run-yandex-summary-live.mjs",
    "check": "npm run lint && npm run typecheck && npm run test:coverage && npm run db:types:check && npm run ios:permissions:check && npm run infra:policy:test && npm run api:check && npm run build",
    "build:ios:local": "tsc -b && vite build --mode development",
    "ios:sync": "npm run build && npx cap sync ios",
    "ios:sync:local": "npm run build:ios:local && npx cap sync ios",
    "ios:sync:production": "npm run ios:sync",
    "ios:open": "npm run ios:sync && npx cap open ios",
    "ios:open:local": "npm run ios:sync:local && npx cap open ios"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/core": "^8.4.2",
    "@capacitor/ios": "^8.4.2",
    "@capgo/capacitor-health": "^8.10.0",
    "@fugood/node-whisper-wasm": "^1.1.1",
    "@hookform/resolvers": "^5.4.0",
    "@supabase/supabase-js": "^2.110.8",
    "@tanstack/react-query": "^5.101.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.82.0",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "jsdom": "^29.1.1",
    "supabase": "^2.109.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
